# Copy to .env.n8n (git-ignored). Never commit real values.

# Encrypts credentials stored inside n8n. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Shared HMAC secret. Must be identical to LENDLOOP_WEBHOOK_SECRET in the Convex env.
LENDLOOP_WEBHOOK_SECRET=

# Convex HTTP actions base URL as seen from inside the container, no trailing slash.
# Local Convex backend: http://host.docker.internal:3211
# Convex cloud:         https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
