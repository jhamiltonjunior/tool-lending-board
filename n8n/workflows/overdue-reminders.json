{
  "id": "LendLoopOverdue1",
  "name": "LendLoop - Daily overdue reminders",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrorWf1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "id": "2a3b8c20-0001-4d4e-8b20-000000000001",
      "name": "Every day at 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] }
      }
    },
    {
      "id": "2a3b8c20-0008-4d4e-8b20-000000000008",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "2a3b8c20-0002-4d4e-8b20-000000000002",
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nconst PATH = '/n8n/overdue-loans';\nconst ts = String(Date.now());\nconst sig = 'sha256=' + crypto.createHmac('sha256', secret).update(`${ts}.GET.${PATH}.`).digest('hex');\nreturn [{ json: { ts, sig } }];"
      }
    },
    {
      "id": "2a3b8c20-0003-4d4e-8b20-000000000003",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-lendloop-timestamp", "value": "={{ $json.ts }}" },
            { "name": "x-lendloop-signature", "value": "={{ $json.sig }}" }
          ]
        },
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "2a3b8c20-0004-4d4e-8b20-000000000004",
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// No overdue loans -> no items -> the run ends here.\nreturn ($input.first().json.loans ?? []).map((loan) => ({ json: loan }));"
      }
    },
    {
      "id": "2a3b8c20-0005-4d4e-8b20-000000000005",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mock channel: logs the reminder. Replace with an email/Slack node in production.\nconst l = $json;\nconsole.log('[LendLoop reminder]', JSON.stringify({ to: l.borrower.email, text: `Hi ${l.borrower.name}, \"${l.toolName}\" was due back on ${l.endDate}. Please return it.` }));\nreturn { json: { loanId: l.loanId, idempotencyKey: l.idempotencyKey, status: 'sent', channel: 'mock' } };"
      }
    },
    {
      "id": "2a3b8c20-0006-4d4e-8b20-000000000006",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// idempotencyKey = loanId:day, so a retry or a second run the same day is a no-op in Convex.\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nconst PATH = '/n8n/reminders';\nconst body = JSON.stringify({ loanId: $json.loanId, idempotencyKey: $json.idempotencyKey, status: $json.status, channel: $json.channel });\nconst ts = String(Date.now());\nconst sig = 'sha256=' + crypto.createHmac('sha256', secret).update(`${ts}.POST.${PATH}.${body}`).digest('hex');\nreturn { json: { body, ts, sig } };"
      }
    },
    {
      "id": "2a3b8c20-0007-4d4e-8b20-000000000007",
      "name": "Write reminder status to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" },
            { "name": "x-lendloop-timestamp", "value": "={{ $json.ts }}" },
            { "name": "x-lendloop-signature", "value": "={{ $json.sig }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": { "timeout": 10000 }
      }
    }
  ],
  "connections": {
    "Every day at 09:00 UTC": { "main": [[{ "node": "Sign request", "type": "main", "index": 0 }]] },
    "Run now (manual)": { "main": [[{ "node": "Sign request", "type": "main", "index": 0 }]] },
    "Sign request": { "main": [[{ "node": "Fetch overdue loans", "type": "main", "index": 0 }]] },
    "Fetch overdue loans": { "main": [[{ "node": "One item per loan", "type": "main", "index": 0 }]] },
    "One item per loan": { "main": [[{ "node": "Send reminder (mock)", "type": "main", "index": 0 }]] },
    "Send reminder (mock)": { "main": [[{ "node": "Sign write-back", "type": "main", "index": 0 }]] },
    "Sign write-back": { "main": [[{ "node": "Write reminder status to Convex", "type": "main", "index": 0 }]] }
  },
  "pinData": {}
}
