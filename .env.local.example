# Next.js (copy to .env.local). `npx convex dev` fills the CONVEX_* values for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk application keys (Clerk dashboard > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The following live in the Convex deployment, not here. Set them with `npx convex env set`:
#   CLERK_JWT_ISSUER_DOMAIN      Clerk Frontend API URL (e.g. https://xxx.clerk.accounts.dev)
#   LENDLOOP_WEBHOOK_SECRET      openssl rand -hex 32 (same value as in .env.n8n)
#   N8N_LOAN_EVENTS_WEBHOOK_URL  http://localhost:5678/webhook/lendloop-loan-events
#   ADMIN_EMAILS                 comma-separated emails that become admin on first sign-in
#   CLERK_SECRET_KEY             optional, same value as above: lets renames show up at once
